{
  "manifest_version": 3,
  "name": "핵심 정리 (Aside)",
  "version": "1.0.0",
  "description": "버튼 한 번으로 현재 페이지 본문을 Aside로 요약합니다.",
  "key": "",
  "permissions": ["sidePanel", "activeTab", "scripting", "nativeMessaging", "tabs", "storage", "alarms", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "핵심 정리" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+0", "mac": "MacCtrl+0" }, "description": "핵심 정리 패널 열기" }
  }
}
